FROM node:18-alpine AS frontend-builder
WORKDIR /app

# 1) 패키지 메타만 복사
COPY semantic-gap-ui/package.json semantic-gap-ui/package-lock.json ./

# 2) production + devDeps 모두 설치
RUN npm install

# 3) 소스 복사 & 빌드
COPY semantic-gap-ui ./
RUN npm run build

# ───────── NGINX Serving ─────────
FROM nginx:stable-alpine
COPY --from=frontend-builder /app/build /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]